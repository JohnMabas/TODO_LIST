{
  "name": "todo-rest-api",
  "version": "1.0.0",
  "description": "A secure Todo REST API built with Node.js and Express.js",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1"
  },
  "keywords": [
