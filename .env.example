PORT=5000
JWT_SECRET=replace-with-a-random-64-character-secret
JWT_EXPIRES_IN=1h
NODE_ENV=development
LOG_LEVEL=info

# Database connection. Either set DATABASE_URL,
# or set PGUSER and PGDATABASE (plus optional PGPASSWORD, PGHOST, PGPORT).
DATABASE_URL=
PGUSER=postgres
PGPASSWORD=
PGDATABASE=todo_api
PGHOST=127.0.0.1
PGPORT=5432
PGPOOL_MAX=10
PGSSL=false